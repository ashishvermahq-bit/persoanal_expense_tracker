# Copy to .env.local for development and fill in. Never commit .env.local.
# On Vercel, set these in Project → Settings → Environment Variables (Production).

# MongoDB connection string. Atlas: a user with readWrite on this one database only.
MONGODB_URI=mongodb://127.0.0.1:27017/expense_tracker

# Signs session cookies. Required, >= 32 characters: `openssl rand -base64 48`.
# Changing it signs everyone out.
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Protects /api/cron/recurring (Vercel Cron sends it as a Bearer token).
# >= 32 characters in production; leave empty to disable the cron route.
CRON_SECRET=

# Public base URL, used for links in emails (password reset). Required in production,
# e.g. https://paisa.example.com (no trailing slash). Never derived from the Host header.
APP_URL=http://localhost:3000

# Optional: sign-in/sign-up attempts per IP (and per email) per 15 minutes. Default 10.
# Only the e2e test server raises it.
# AUTH_RATE_LIMIT_MAX=10
