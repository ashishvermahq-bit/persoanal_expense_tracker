# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Generate each secret with:  openssl rand -hex 32
# (hex only: the MongoDB passwords go inside a connection URL, so avoid symbols)

# The address people type, exactly as nginx serves it. No trailing slash.
APP_URL=https://paisa.example.com

AUTH_SECRET=
CRON_SECRET=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# Password-reset email through Resend. Set both or leave both empty.
RESEND_API_KEY=
EMAIL_FROM=

# Host port the app listens on (127.0.0.1 only); nginx proxies to it.
# APP_PORT=3000
